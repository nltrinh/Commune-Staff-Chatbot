# =================================================================
# COMMUNE STAFF CHATBOT - ENVIRONMENT CONFIGURATION
# =================================================================

# --- CHẾ ĐỘ VẬN HÀNH (MOCK vs PRODUCTION) ---
# True: Sử dụng dữ liệu giả, không cần GPU, không cần Ollama.
# False: Sử dụng AI thật (Ollama + Qwen2.5), yêu cầu GPU.
USE_MOCK_AI=True

# --- THÔNG TIN APP ---
APP_TITLE=Trợ lý Hành chính Xã
APP_VERSION=2.0.0

# --- BẢO MẬT (AUTH) ---
SECRET_KEY=thay_doi_key_nay_khi_trien_khai_thuc_te_123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- TÀI KHOẢN ADMIN MẶC ĐỊNH ---
ADMIN_USERNAME=host_admin
ADMIN_PASSWORD=admin123

# --- MONGODB CONFIGURATION ---
# Dùng "mongodb://db:27017/?replicaSet=rs0" nếu chạy Docker Compose
# Dùng "mongodb://localhost:27017/?replicaSet=rs0" nếu chạy trực tiếp trên máy
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB_NAME=commune_staff_bot

# Chế độ Vector Search: 
# - "atlas": Dùng cho MongoDB Atlas (Cloud)
# - "native": Dùng cho MongoDB 8.2+ Local (Khuyên dùng cho Vast.ai)
MONGODB_VECTOR_MODE=native
VECTOR_INDEX_NAME=vector_index

# --- OLLAMA (AI ENGINE) ---
# Nếu chạy docker-compose, dùng: http://host.docker.internal:11434 (để gọi Ollama trên máy host)
# Nếu chạy trực tiếp, dùng: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:14b
EMBED_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- RAG PARAMETERS ---
TOP_K_RESULTS=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50
OLLAMA_NUM_PREDICT=1000
